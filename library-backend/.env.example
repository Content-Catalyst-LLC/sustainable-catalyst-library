DATABASE_URL=postgresql://sc_library:CHANGE_ME@sc-postgres:5432/sc_library
SC_LIBRARY_BACKEND_API_KEY=GENERATE_A_LONG_RANDOM_SECRET
SC_LIBRARY_ENVIRONMENT=production
SC_LIBRARY_ALLOWED_ORIGINS=https://sustainablecatalyst.com,https://library.sustainablecatalyst.com
SC_LIBRARY_MAX_BATCH_RECORDS=200
SC_LIBRARY_MAX_BODY_MB=12
SC_LIBRARY_REQUEST_SKEW_SECONDS=300
SC_LIBRARY_DB_POOL_MIN=1
SC_LIBRARY_DB_POOL_MAX=10
SC_LIBRARY_STATEMENT_TIMEOUT_MS=8000
SC_LIBRARY_ENABLE_DOCS=false

SC_LIBRARY_BIOMEDICAL_TIMEOUT_SECONDS=8
SC_LIBRARY_NCBI_TOOL=sustainable_catalyst_library
SC_LIBRARY_NCBI_EMAIL=
SC_LIBRARY_NCBI_API_KEY=

SC_LIBRARY_FDA_TIMEOUT_SECONDS=8
SC_LIBRARY_OPENFDA_API_KEY=

# v1.5.0 WHO ICD-11 terminology integration
SC_LIBRARY_MEDICAL_TERMINOLOGY_TIMEOUT_SECONDS=8
SC_LIBRARY_WHO_ICD_BASE_URL=https://id.who.int
SC_LIBRARY_WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
SC_LIBRARY_WHO_ICD_CLIENT_ID=
SC_LIBRARY_WHO_ICD_CLIENT_SECRET=
SC_LIBRARY_WHO_ICD_RELEASE_ID=2026-01
SC_LIBRARY_WHO_ICD_LANGUAGE=en
SC_LIBRARY_WHO_ICD_LOCAL_MODE=false

# Platform Core Research Bridge (Library v5.12.0 / backend v2.23.0)
SC_LIBRARY_PLATFORM_CORE_URL=https://core.sustainablecatalyst.com
SC_LIBRARY_PLATFORM_CORE_WRITE_API_KEY=
SC_LIBRARY_PLATFORM_CORE_TIMEOUT_SECONDS=8
SC_LIBRARY_PLATFORM_CORE_MAX_ATTEMPTS=5

# Hybrid Research Retrieval (Library v5.13.0 / backend v2.24.0)
# Provider: disabled | gemini | openai_compatible
# If SC_LIBRARY_EMBEDDING_PROVIDER is omitted and GEMINI_API_KEY is present, Gemini activates automatically.
SC_LIBRARY_EMBEDDING_PROVIDER=disabled
SC_LIBRARY_EMBEDDING_API_KEY=
SC_LIBRARY_EMBEDDING_MODEL=gemini-embedding-2
SC_LIBRARY_EMBEDDING_API_URL=
SC_LIBRARY_EMBEDDING_DIMENSIONS=768
SC_LIBRARY_EMBEDDING_TIMEOUT_SECONDS=12
SC_LIBRARY_EMBEDDING_MAX_ATTEMPTS=5
SC_LIBRARY_EMBEDDING_WORKER_ENABLED=true
SC_LIBRARY_EMBEDDING_WORKER_INTERVAL_SECONDS=30
SC_LIBRARY_EMBEDDING_WORKER_BATCH_SIZE=10
SC_LIBRARY_HYBRID_CANDIDATE_MULTIPLIER=4
SC_LIBRARY_HYBRID_RRF_K=60
SC_LIBRARY_HYBRID_LEXICAL_WEIGHT=1.0
SC_LIBRARY_HYBRID_SEMANTIC_WEIGHT=1.0

# v5.42 neural reranking. Disabled by default; no fake neural scores are generated.
# rerank_compatible expects POST {model,query,documents,top_n,return_documents}
# and response {results:[{index,relevance_score}]}.
SC_LIBRARY_RERANK_PROVIDER=disabled
SC_LIBRARY_RERANK_API_KEY=
SC_LIBRARY_RERANK_MODEL=rerank-model
SC_LIBRARY_RERANK_API_URL=
SC_LIBRARY_RERANK_TIMEOUT_SECONDS=12
SC_LIBRARY_RERANK_MAX_CANDIDATES=40
SC_LIBRARY_SEMANTIC_MIN_SIMILARITY=0.0


# Citation Graph & Scholarly Lineage (Library v5.14.0 / backend v2.25.0)
# No additional secret is required. Platform Core scholarly citation promotion uses
# the existing SC_LIBRARY_PLATFORM_CORE_WRITE_API_KEY backend-only credential.

# Go Research Ingestion & Job Fabric (Library v5.36.0 / backend v2.47.0)
SC_LIBRARY_GO_INGESTION_URL=http://sc-library-ingestion:8090
SC_LIBRARY_GO_MAX_QUEUE=5000
SC_LIBRARY_GO_MAX_IN_FLIGHT=32

# Scientific Embedding Governance & Compute Handoff (Library v5.40.0.1 / backend v2.51.1)
# local: current Library worker executes embeddings.
# workspace_preferred: Workspace handoff is preferred; terminal Workspace failure returns the job to local fallback.
# workspace_only: only Workspace handoff execution is permitted for newly queued/backfilled embedding jobs.
SC_LIBRARY_EMBEDDING_COMPUTE_TARGET=local

# Durable Research Job Queue & Execution State (Library v5.49.0 / backend v2.60.0)
# PostgreSQL remains authoritative. Redis only dispatches wake-up notifications.
SC_LIBRARY_JOB_REDIS_URL=redis://sc-library-redis:6379/0
SC_LIBRARY_JOB_REDIS_STREAM=sc:library:research-jobs
SC_LIBRARY_JOB_REDIS_STREAM_MAXLEN=10000
SC_LIBRARY_JOB_DISPATCH_ENABLED=true
SC_LIBRARY_JOB_LEASE_SECONDS=120
SC_LIBRARY_JOB_DEFAULT_MAX_ATTEMPTS=5

# Specialized Worker Runtime & Failure Isolation (Library v5.50.0 / backend v2.61.0)
SC_LIBRARY_WORKER_QUARANTINE_THRESHOLD=5
SC_LIBRARY_WORKER_STALE_SECONDS=180

# Research Artifact & Object Storage Fabric (Library v5.51.0 / backend v2.62.0)
# filesystem is the safe default. Set s3 for an S3-compatible provider such as MinIO/R2/S3.
SC_LIBRARY_ARTIFACT_STORE_BACKEND=filesystem
SC_LIBRARY_ARTIFACT_FILESYSTEM_ROOT=/data/artifacts
SC_LIBRARY_ARTIFACT_MAX_INLINE_MB=32
SC_LIBRARY_ARTIFACT_S3_ENDPOINT_URL=
SC_LIBRARY_ARTIFACT_S3_REGION=us-east-1
SC_LIBRARY_ARTIFACT_S3_BUCKET=
SC_LIBRARY_ARTIFACT_S3_PREFIX=library-artifacts
SC_LIBRARY_ARTIFACT_S3_ACCESS_KEY=
SC_LIBRARY_ARTIFACT_S3_SECRET_KEY=

# Checkpointed Ingestion & Research Pipeline Engine (Library v5.52.0 / backend v2.63.0)
SC_LIBRARY_PIPELINE_MAX_STAGES=100
SC_LIBRARY_PIPELINE_RESUME_ENABLED=true
# Distributed Research Compute Broker & Runtime Observability (Library v5.53.0 / backend v2.64.0)
SC_LIBRARY_COMPUTE_MAX_QUEUED_JOBS=5000
SC_LIBRARY_COMPUTE_MAX_RUNNING_JOBS=256
SC_LIBRARY_COMPUTE_MAX_CAPABILITY_QUEUE=1000
SC_LIBRARY_COMPUTE_OBSERVATION_WINDOW_MINUTES=60

