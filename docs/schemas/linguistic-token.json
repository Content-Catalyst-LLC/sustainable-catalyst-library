{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/linguistic-token.json",
  "title": "Sustainable Catalyst Linguistic Token",
  "type": "object",
  "required": ["schema", "token_id", "document_id", "representation_id", "sequence", "text", "normalized_text", "token_kind", "start_char", "end_char", "text_sha256"],
  "properties": {
    "schema": {"const": "sc-library-linguistic-token/1.0"},
    "token_id": {"type": "string", "pattern": "^lingtok:[0-9a-f]{32}$"},
    "document_id": {"type": "string"},
    "representation_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "text": {"type": "string"},
    "normalized_text": {"type": "string"},
    "token_kind": {"enum": ["word", "punctuation"]},
    "start_char": {"type": "integer", "minimum": 0},
    "end_char": {"type": "integer", "minimum": 0},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
