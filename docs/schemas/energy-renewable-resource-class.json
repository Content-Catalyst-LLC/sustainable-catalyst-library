{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/energy-renewable-resource-class.json",
  "title": "Sustainable Catalyst Renewable Resource Class",
  "type": "object",
  "required": ["key", "label", "resource_kind", "applicable_technologies", "observation_fields", "source_keys", "quantitative_dataset_status", "suitability_status", "note"],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "label": {"type": "string", "minLength": 1},
    "resource_kind": {"type": "string", "minLength": 1},
    "applicable_technologies": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "observation_fields": {"type": "array", "minItems": 10, "items": {"type": "string"}, "uniqueItems": true},
    "source_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "quantitative_dataset_status": {"const": "not-loaded"},
    "suitability_status": {"const": "not-assessed"},
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
