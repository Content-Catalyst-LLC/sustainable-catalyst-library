{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/source-media-asset.json",
  "title": "Source Media Asset",
  "type": "object",
  "required": ["schema", "source_asset_id", "asset_fingerprint_sha256", "media_type", "raw_payload_sha256", "raw_byte_length"],
  "properties": {
    "schema": {"const": "sc-library-source-media-asset/1.0"},
    "source_asset_id": {"type": "string", "pattern": "^srcasset:[0-9a-f]{32}$"},
    "asset_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": ["string", "null"]},
    "source_record_id": {"type": ["string", "null"]},
    "record_id": {"type": ["string", "null"]},
    "source_uri": {"type": ["string", "null"]},
    "media_type": {"type": "string"},
    "raw_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_byte_length": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
