{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/energy-renewable-technology-definition.json",
  "title": "Sustainable Catalyst Renewable Technology Definition",
  "type": "object",
  "required": ["key", "label", "family", "resource_class", "primary_outputs", "conversion_scope", "related_concepts", "source_keys", "evidence_status", "quantitative_profile_status", "suitability_status", "note"],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "label": {"type": "string", "minLength": 1},
    "family": {"type": "string", "enum": ["solar", "wind", "hydro", "marine", "bioenergy"]},
    "resource_class": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "primary_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "conversion_scope": {"type": "string", "minLength": 1},
    "related_concepts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_keys": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "evidence_status": {"type": "string"},
    "quantitative_profile_status": {"const": "not-populated"},
    "suitability_status": {"const": "not-assessed"},
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
