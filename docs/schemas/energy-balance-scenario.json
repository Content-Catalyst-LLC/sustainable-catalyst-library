  "properties": {
    "scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "geography": {},
    "period": {
      "type": "object"
    },
    "energy_unit": {
      "const": "kwh"
    },
    "supply": {
      "type": "object"
    },
    "conversion": {
      "type": "object"
    },
    "demand": {
      "type": "object"
    },
    "accounting": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "uncertainty": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
