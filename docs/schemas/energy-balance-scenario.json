{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/energy-balance-scenario.json",
  "title": "Sustainable Catalyst Energy Balance Scenario Packet",
  "type": "object",
  "required": [
    "scenario_id",
    "name",
    "geography",
    "period",
    "energy_unit",
    "supply",
    "conversion",
    "demand",
    "accounting",
    "evidence",
    "uncertainty"
