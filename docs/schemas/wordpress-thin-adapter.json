{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc-library-wordpress-thin-adapter/1.0",
  "title": "Knowledge Library WordPress Thin Adapter",
  "type": "object",
  "required": [
    "schema",
    "library_version",
    "backend_version",
    "adapter",
    "allowed_responsibilities",
    "prohibited_authorities",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-wordpress-thin-adapter/1.0"
    },
    "library_version": {
      "type": "string"
    },
    "backend_version": {
      "type": "string"
    },
    "adapter": {
      "type": "object"
    },
    "allowed_responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_authorities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "guardrails": {
      "type": "object"
    }
  }
}
