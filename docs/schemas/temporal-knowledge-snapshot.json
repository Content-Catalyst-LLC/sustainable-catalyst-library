{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/temporal-knowledge-snapshot/1.0",
  "title": "Sustainable Catalyst Temporal Knowledge Snapshot",
  "type": "object",
  "required": [
    "schema",
    "as_of",
    "lens",
    "record_count",
    "records",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-temporal-knowledge-snapshot/1.0"
    },
    "as_of": {
      "type": "string"
    },
    "lens": {
      "enum": [
        "historical-availability",
        "retrospective-status"
      ]
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array"
    },
    "guardrails": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
