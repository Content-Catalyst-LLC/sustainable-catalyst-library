{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/publication-embedding-map.json",
  "title": "Sustainable Catalyst Publication Embedding Map",
  "type": "object",
  "required": ["schema", "available", "points", "edges", "guardrails"],
  "properties": {
    "schema": {"const": "sc-library-publication-embedding-map/1.0"},
    "landscape_schema": {"const": "sc-library-semantic-knowledge-landscape/1.0"},
    "map_id": {"type": ["string", "null"]},
    "available": {"type": "boolean"},
    "points": {"type": "array", "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "neighborhoods": {"type": "object"},
    "projection": {"type": "object"},
    "specification": {"type": "object"},
    "guardrails": {"type": "object"}
  },
  "additionalProperties": true
}
