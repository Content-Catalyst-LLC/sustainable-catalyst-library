{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/energy-platform-contract.json",
  "title": "Energy Platform Cross-Product Contract",
  "type": "object",
  "required": ["key", "target", "purpose", "contract_refs", "availability", "execution_state", "boundary"],
  "properties": {
    "key": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "contract_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "availability": {"enum": ["available", "contract-available"]},
    "execution_state": {"enum": ["host-runtime-active", "not-activated-by-this-release"]},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
