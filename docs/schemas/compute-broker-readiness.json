{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC Library Distributed Compute Broker Readiness",
  "type": "object",
  "required": [
    "schema",
    "version",
    "backend_version",
    "state",
    "profiles",
    "capabilities",
    "limits",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-distributed-compute-broker-readiness/1.0"
    },
    "version": {
      "const": "5.53.0"
    },
    "backend_version": {
      "const": "2.64.0"
    },
    "state": {
      "enum": [
        "ready",
        "degraded",
        "unavailable"
      ]
    },
    "profiles": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "limits": {
      "type": "object"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
