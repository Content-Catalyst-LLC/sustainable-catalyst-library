{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC Library API Error",
  "type": "object",
  "required": [
    "schema",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-api-error/1.0"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "status"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        }
      }
    }
  }
}
