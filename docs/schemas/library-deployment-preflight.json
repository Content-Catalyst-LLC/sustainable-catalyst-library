{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library Deployment Preflight",
  "type": "object",
  "required": [
    "artifact_hashes_verified",
    "database_ready",
    "backend_health_ready",
    "rollback_snapshot_retained",
    "disk_capacity_ready",
    "port_allocation_safe"
  ],
  "properties": {
    "artifact_hashes_verified": {
      "type": "boolean"
    },
    "database_ready": {
      "type": "boolean"
    },
    "backend_health_ready": {
      "type": "boolean"
    },
    "rollback_snapshot_retained": {
      "type": "boolean"
    },
    "disk_capacity_ready": {
      "type": "boolean"
    },
    "port_allocation_safe": {
      "type": "boolean"
    }
  }
}
