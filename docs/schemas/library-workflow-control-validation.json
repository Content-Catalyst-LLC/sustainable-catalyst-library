{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/library-workflow-control-validation.json",
  "title": "Sustainable Catalyst Workflow Control Validation",
  "type": "object",
  "required": [
    "schema",
    "valid",
    "errors",
    "normalized",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-workflow-control-validation/1.0"
    },
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "normalized": {
      "type": "object"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
