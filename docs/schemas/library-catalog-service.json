{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/library-catalog-service.json",
  "title": "Sustainable Catalyst Library Catalog Service Contract",
  "type": "object",
  "required": [
    "schema",
    "library_version",
    "backend_version",
    "state",
    "authority",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-python-catalog-service/1.0"
    },
    "library_version": {
      "const": "5.70.0"
    },
    "backend_version": {
      "const": "2.81.0"
    },
    "state": {
      "const": "authoritative"
    },
    "authority": {
      "const": "python-backend"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
