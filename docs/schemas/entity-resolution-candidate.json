{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Resolution Candidate",
  "type": "object",
  "required": [
    "schema",
    "candidate_id",
    "entity_id",
    "rank",
    "score",
    "signals"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-entity-resolution-candidate/1.0"
    },
    "candidate_id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "array"
    }
  }
}
