{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-Product Library Service Integration",
  "type": "object",
  "required": [
    "schema",
    "library_version",
    "backend_version",
    "product_count",
    "products",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-cross-product-service-integration/1.0"
    },
    "library_version": {
      "type": "string"
    },
    "backend_version": {
      "type": "string"
    },
    "product_count": {
      "type": "integer",
      "minimum": 1
    },
    "products": {
      "type": "object"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
