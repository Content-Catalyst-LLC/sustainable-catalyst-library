{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/library-research-state-service.json",
  "title": "Sustainable Catalyst Library Research State Service",
  "type": "object",
  "required": ["schema", "library_version", "backend_version", "state", "authority", "persistence", "owner_identity", "objects", "guardrails"],
  "properties": {
    "schema": {"const": "sc-library-python-research-state-service/1.0"},
    "library_version": {"const": "5.71.0"},
    "backend_version": {"const": "2.82.0"},
    "state": {"const": "authoritative"},
    "authority": {"const": "python-backend"},
    "persistence": {"const": "postgresql"},
    "owner_identity": {"const": "library-identity"},
    "objects": {"type": "object"},
    "guardrails": {"type": "object"}
  }
}
