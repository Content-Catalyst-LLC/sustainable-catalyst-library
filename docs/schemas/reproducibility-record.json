{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sustainable Catalyst Reproducibility Record",
  "type": "object",
  "required": [
    "schema",
    "record_id",
    "workload",
    "input_fingerprint_sha256",
    "semantic_result_fingerprint_sha256",
    "execution_environment",
    "lineage"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-reproducibility-record/1.0"
    },
    "record_id": {
      "type": "string"
    },
    "workload": {
      "type": "string"
    },
    "input_fingerprint_sha256": {
      "type": "string"
    },
    "semantic_result_fingerprint_sha256": {
      "type": "string"
    },
    "execution_environment": {
      "type": "object"
    },
    "lineage": {
      "type": "object"
    }
  }
}
