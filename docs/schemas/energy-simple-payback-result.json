{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/energy-simple-payback-result.json",
  "title": "Energy simple payback result",
  "type": "object",
  "required": [
    "ok",
    "schema",
    "model_version",
    "input",
    "output",
    "boundary"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "schema": {
      "type": "string"
    },
    "model_version": {
      "const": "0.6.0"
    },
    "input": {
      "type": "object",
      "required": [
        "initial_cost",
        "annual_net_savings"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "payback_years": {
          "type": [
            "string",
            "null"
          ]
        },
        "payback_status": {
          "type": "string"
        }
      }
    },
    "boundary": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
