{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC Library API Service Contract",
  "type": "object",
  "required": [
    "schema",
    "contract_id",
    "api_version",
    "base_path",
    "state",
    "routes",
    "capabilities",
    "auth",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-api-service-contract/1.0"
    },
    "api_version": {
      "const": "1.0"
    },
    "base_path": {
      "const": "/api/library/v1"
    },
    "state": {
      "const": "stable"
    },
    "contract_id": {
      "type": "string"
    },
    "routes": {
      "type": "array"
    },
    "capabilities": {
      "type": "object"
    },
    "auth": {
      "type": "object"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
