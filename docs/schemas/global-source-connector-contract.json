{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/global-source-connector-contract.json",
  "title": "Sustainable Catalyst Global Source Connector Contract",
  "type": "object",
  "required": ["schema", "connector_id", "source_id", "execution_authority", "transport", "capabilities", "authentication", "pagination", "rate_limit_policy", "provenance_fields"],
  "properties": {
    "schema": {"const": "sc-library-global-source-connector-contract/1.0"},
    "connector_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "execution_authority": {"type": "string", "minLength": 1},
    "transport": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authentication": {"type": "string"},
    "pagination": {"type": "string"},
    "rate_limit_policy": {"type": "string"},
    "provenance_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "language_policy": {"const": "preserve-as-received"},
    "translation_behavior": {"const": "none"},
    "raw_source_preservation": {"const": true},
    "automatic_import": {"const": false},
    "automatic_evidence_promotion": {"const": false},
    "automatic_truth_promotion": {"const": false},
    "source_membership_implies_endorsement": {"const": false}
  },
  "additionalProperties": true
}
