{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC Library Job Attempt",
  "type": "object",
  "required": [
    "schema",
    "attempt_id",
    "job_id",
    "attempt_no",
    "worker_id",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-job-attempt/1.0"
    },
    "attempt_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "worker_id": {
      "type": "string"
    },
    "state": {
      "type": "string"
    }
  }
}
