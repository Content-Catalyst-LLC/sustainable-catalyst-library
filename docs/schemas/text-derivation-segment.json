{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/text-derivation-segment.json",
  "title": "Text Derivation Segment",
  "type": "object",
  "required": ["schema", "segment_id", "run_id", "sequence", "segment_kind", "text_sha256", "review_state"],
  "properties": {
    "schema": {"const": "sc-library-text-derivation-segment/1.0"},
    "segment_id": {"type": "string", "pattern": "^textseg:[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^textrun:[0-9a-f]{32}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "segment_kind": {"type": "string"},
    "page_number": {"type": ["integer", "null"], "minimum": 1},
    "start_ms": {"type": ["integer", "null"], "minimum": 0},
    "end_ms": {"type": ["integer", "null"], "minimum": 0},
    "bounding_box": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "speaker_label": {"type": ["string", "null"]},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "review_state": {"enum": ["unreviewed", "in-review", "human-reviewed", "accepted", "rejected"]}
  },
  "additionalProperties": true
}
