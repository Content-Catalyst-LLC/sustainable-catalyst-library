{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/energy-global-metric-definition.json",
  "title": "Energy Global Metric Definition",
  "type": "object",
  "required": ["key","label","category","unit","source_key","source_indicator","related_eisd","interpretation","source_semantics","current_state_claim"],
  "properties": {
    "key": {"type":"string","minLength":1},
    "label": {"type":"string","minLength":1},
    "category": {"type":"string","minLength":1},
    "unit": {"type":"string","minLength":1},
    "source_key": {"type":"string","const":"world-bank-wdi"},
    "source_indicator": {"type":"string","pattern":"^[A-Z0-9.]+$"},
    "related_eisd": {"type":"array","items":{"type":"string"}},
    "interpretation": {"type":"string","minLength":1},
    "source_semantics": {"type":"string","minLength":1},
    "current_state_claim": {"type":"boolean","const":false}
  },
  "additionalProperties": false
}
