{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Library Deployment Certification",
  "type": "object",
  "required": [
    "certified",
    "certification_sha256"
  ],
  "properties": {
    "certified": {
      "type": "boolean"
    },
    "certification_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
