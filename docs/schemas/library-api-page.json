  "title": "SC Library API Page",
  "type": "object",
  "required": [
    "schema",
    "items",
    "page"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-api-page/1.0"
    },
    "items": {
      "type": "array"
    },
    "page": {
      "type": "object",
