  "$id": "https://sustainablecatalyst.com/schemas/library-connector-runtime-status.json",
  "title": "Sustainable Catalyst Connector Runtime Status",
  "type": "object",
  "required": ["schema", "connector_id", "source_id", "mode", "python_native", "wordpress_fallback_allowed"],
