{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Graph Path Request",
  "type": "object",
  "properties": {
    "query": {
      "type": "object",
      "properties": {
        "runtime": {
          "enum": [
            "auto",
            "rust",
            "python"
          ]
        },
        "max_hops": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_paths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    }
  }
}
