{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SC Library Compute Request Validation",
  "type": "object",
  "required": [
    "schema",
    "version",
    "backend_version",
    "valid",
    "errors",
    "guardrails"
  ],
  "properties": {
    "schema": {
      "const": "sc-library-compute-request-validation/1.0"
    },
    "version": {
      "const": "5.53.0"
    },
    "backend_version": {
      "const": "2.64.0"
    },
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized": {
      "type": "object"
    },
    "guardrails": {
      "type": "object"
    }
  }
}
