{
  "openapi": "3.1.0",
  "info": {
    "title": "Sustainable Catalyst Knowledge Library API",
    "version": "1.0.0",
    "description": "Stable WordPress-independent Knowledge Library service contract."
  },
  "servers": [
    {
      "url": "/api/library/v1"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "libraryServiceRoot",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/service": {
      "get": {
        "operationId": "libraryServiceContract",
        "responses": {
          "200": {
            "description": "Service contract"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "libraryApiHealth",
        "responses": {
          "200": {
            "description": "Health"
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "operationId": "libraryApiReadiness",
        "responses": {
          "200": {
            "description": "Readiness"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "libraryApiCapabilities",
        "responses": {
          "200": {
            "description": "Capabilities"
          }
        }
      }
    },
    "/routes": {
      "get": {
        "operationId": "libraryApiRoutes",
        "responses": {
          "200": {
            "description": "Route catalog"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "librarySearch",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          }
        }
      }
    },
    "/records/{record_id}": {
      "get": {
        "operationId": "libraryRecord",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/research-jobs": {
      "post": {
        "operationId": "submitResearchJob",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable research job"
          }
        }
      }
    },
    "/web-application": {
      "get": {
        "summary": "Independent Library web application contract",
        "responses": {
          "200": {
            "description": "Web application contract"
          }
        }
      }
    },
    "/web-application/readiness": {
      "get": {
        "summary": "Independent Library web application readiness",
        "responses": {
          "200": {
            "description": "Web application readiness"
          }
        }
      }
    },
    "/identity": {
      "get": {
        "summary": "Identity/session/access boundary contract",
        "responses": {
          "200": {
            "description": "Identity boundary"
          }
        }
      }
    },
    "/identity/readiness": {
      "get": {
        "summary": "Identity boundary readiness",
        "responses": {
          "200": {
            "description": "Identity readiness"
          }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Current Library session",
        "responses": {
          "200": {
            "description": "Session state"
          }
        }
      }
    },
    "/session/login": {
      "post": {
        "summary": "Exchange Library credentials for an opaque service-native session",
        "responses": {
          "200": {
            "description": "Authenticated session"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/session/logout": {
      "post": {
        "summary": "Revoke current Library session",
        "parameters": [
          {
            "name": "X-SC-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked"
          },
          "403": {
            "description": "CSRF required"
          }
        }
      }
    },
    "/access/evaluate": {
      "get": {
        "summary": "Evaluate current session against a scope/resource",
        "responses": {
          "200": {
            "description": "Access decision"
          }
        }
      }
    },
    "/admin/identities": {
      "post": {
        "summary": "Create or update a Library identity",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/admin/identities/{identity_id}/password": {
      "post": {
        "summary": "Set Library password credential",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/admin/identities/{identity_id}/roles": {
      "post": {
        "summary": "Bind a Library role",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/admin/access-grants": {
      "post": {
        "summary": "Create explicit Library access grant",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/wordpress-adapter": {
      "get": {
        "operationId": "libraryWordPressThinAdapterContract",
        "responses": {
          "200": {
            "description": "WordPress thin-adapter contract"
          }
        }
      }
    },
    "/wordpress-adapter/readiness": {
      "get": {
        "operationId": "libraryWordPressThinAdapterReadiness",
        "responses": {
          "200": {
            "description": "WordPress thin-adapter readiness"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "signedService": {
        "type": "apiKey",
        "in": "header",
        "name": "X-SC-Signature",
        "description": "Signed service request; Authorization and X-SC-Timestamp are also required."
      },
      "librarySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sc_library_session",
        "description": "Opaque revocable Library session cookie; token is never stored in plaintext server-side."
      }
    }
  }
}
