{
  "openapi": "3.1.0",
  "info": {
    "title": "Sustainable Catalyst Knowledge Library API",
    "version": "1.0.0",
    "description": "Stable WordPress-independent Knowledge Library service contract."
  },
  "servers": [
    {
      "url": "/api/library/v1"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "libraryServiceRoot",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/service": {
      "get": {
        "operationId": "libraryServiceContract",
        "responses": {
          "200": {
            "description": "Service contract"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "libraryApiHealth",
        "responses": {
          "200": {
            "description": "Health"
          }
        }
      }
    },
    "/readiness": {
      "get": {
        "operationId": "libraryApiReadiness",
        "responses": {
          "200": {
            "description": "Readiness"
          }
        }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "libraryApiCapabilities",
        "responses": {
          "200": {
            "description": "Capabilities"
          }
        }
      }
    },
    "/routes": {
      "get": {
        "operationId": "libraryApiRoutes",
        "responses": {
          "200": {
            "description": "Route catalog"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "librarySearch",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results"
          }
        }
      }
    },
    "/records/{record_id}": {
      "get": {
        "operationId": "libraryRecord",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/research-jobs": {
      "post": {
        "operationId": "submitResearchJob",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable research job"
          }
        }
      }
    },
    "/web-application": {
      "get": {
        "summary": "Independent Library web application contract",
        "responses": {
          "200": {
            "description": "Web application contract"
          }
        }
      }
    },
    "/web-application/readiness": {
      "get": {
        "summary": "Independent Library web application readiness",
        "responses": {
          "200": {
            "description": "Web application readiness"
          }
        }
      }
    },
    "/identity": {
      "get": {
        "summary": "Identity/session/access boundary contract",
        "responses": {
          "200": {
            "description": "Identity boundary"
          }
        }
      }
    },
    "/identity/readiness": {
      "get": {
        "summary": "Identity boundary readiness",
        "responses": {
          "200": {
            "description": "Identity readiness"
          }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Current Library session",
        "responses": {
          "200": {
            "description": "Session state"
          }
        }
      }
    },
    "/session/login": {
      "post": {
        "summary": "Exchange Library credentials for an opaque service-native session",
        "responses": {
          "200": {
            "description": "Authenticated session"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/session/logout": {
      "post": {
        "summary": "Revoke current Library session",
        "parameters": [
          {
            "name": "X-SC-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session revoked"
          },
          "403": {
            "description": "CSRF required"
          }
        }
      }
    },
    "/access/evaluate": {
      "get": {
        "summary": "Evaluate current session against a scope/resource",
        "responses": {
          "200": {
            "description": "Access decision"
          }
        }
      }
    },
    "/admin/identities": {
      "post": {
        "summary": "Create or update a Library identity",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/admin/identities/{identity_id}/password": {
      "post": {
        "summary": "Set Library password credential",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/admin/identities/{identity_id}/roles": {
      "post": {
        "summary": "Bind a Library role",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/admin/access-grants": {
      "post": {
        "summary": "Create explicit Library access grant",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Created"
          }
        }
      }
    },
    "/wordpress-adapter": {
      "get": {
        "operationId": "libraryWordPressThinAdapterContract",
        "responses": {
          "200": {
            "description": "WordPress thin-adapter contract"
          }
        }
      }
    },
    "/wordpress-adapter/readiness": {
      "get": {
        "operationId": "libraryWordPressThinAdapterReadiness",
        "responses": {
          "200": {
            "description": "WordPress thin-adapter readiness"
          }
        }
      }
    },
    "/public-routing": {
      "get": {
        "summary": "Public routing, SEO and embed bridge contract",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/public-routing/readiness": {
      "get": {
        "summary": "Public routing bridge readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/seo/records/{record_id}": {
      "get": {
        "summary": "Record SEO descriptor",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/embed/records/{record_id}": {
      "get": {
        "summary": "Record embed descriptor",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/integrations": {
      "get": {
        "summary": "List direct Sustainable Catalyst product integrations",
        "responses": {
          "200": {
            "description": "Cross-product service registry"
          }
        }
      }
    },
    "/integrations/readiness": {
      "get": {
        "summary": "Cross-product integration readiness",
        "responses": {
          "200": {
            "description": "Integration readiness"
          }
        }
      }
    },
    "/integrations/{product_key}": {
      "get": {
        "summary": "Get one product service contract",
        "parameters": [
          {
            "name": "product_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product client contract"
          },
          "404": {
            "description": "Unknown product"
          }
        }
      }
    },
    "/integrations/{product_key}/exchange/validate": {
      "post": {
        "summary": "Validate a scoped cross-product exchange",
        "security": [
          {
            "signedService": []
          }
        ],
        "parameters": [
          {
            "name": "product_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exchange validation"
          },
          "404": {
            "description": "Unknown product"
          }
        }
      }
    },
    "/admin/integrations/{product_key}/bindings": {
      "post": {
        "summary": "Persist non-secret product service binding metadata",
        "security": [
          {
            "signedService": []
          }
        ],
        "parameters": [
          {
            "name": "product_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service binding"
          },
          "404": {
            "description": "Unknown product"
          }
        }
      }
    },
    "/state-migration": {
      "get": {
        "summary": "Get WordPress legacy research-state migration contract",
        "responses": {
          "200": {
            "description": "Migration contract"
          }
        }
      }
    },
    "/state-migration/readiness": {
      "get": {
        "summary": "Get state migration readiness",
        "responses": {
          "200": {
            "description": "Migration readiness"
          }
        }
      }
    },
    "/state-migration/certifications/{certification_id}": {
      "get": {
        "summary": "Get retirement certification",
        "parameters": [
          {
            "name": "certification_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retirement certification"
          },
          "404": {
            "description": "Certification not found"
          }
        }
      }
    },
    "/admin/state-migration/validate": {
      "post": {
        "summary": "Validate a WordPress migration manifest",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result"
          }
        }
      }
    },
    "/admin/state-migration/import": {
      "post": {
        "summary": "Import a certified-shape WordPress migration manifest",
        "security": [
          {
            "signedService": []
          }
        ],
        "responses": {
          "200": {
            "description": "Migration run"
          }
        }
      }
    },
    "/admin/state-migration/{run_id}/certify": {
      "post": {
        "summary": "Certify a complete migration for WordPress authority retirement",
        "security": [
          {
            "signedService": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retirement certification"
          },
          "404": {
            "description": "Migration run not found"
          }
        }
      }
    },
    "/api/library/v1/release-engineering": {
      "get": {
        "summary": "Independent release manifest",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/library/v1/release-engineering/readiness": {
      "get": {
        "summary": "Release engineering readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/library/v1/runtime-certification": {
      "get": {
        "summary": "WordPress failure independence certification",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/library/v1/runtime-certification/readiness": {
      "get": {
        "summary": "Runtime certification readiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/client-framework": {
      "get": {
        "operationId": "libraryClientFramework",
        "responses": {
          "200": {
            "description": "First-party SDK and client framework contract"
          }
        }
      }
    },
    "/client-framework/readiness": {
      "get": {
        "operationId": "libraryClientFrameworkReadiness",
        "responses": {
          "200": {
            "description": "SDK and client framework readiness"
          }
        }
      }
    },
    "/domain-authority": {
      "get": {
        "operationId": "libraryPythonDomainAuthority",
        "responses": {
          "200": {
            "description": "Python domain authority contract"
          }
        }
      }
    },
    "/domain-authority/readiness": {
      "get": {
        "operationId": "libraryPythonDomainAuthorityReadiness",
        "responses": {
          "200": {
            "description": "Python domain authority readiness"
          }
        }
      }
    },
    "/domain-authority/migration-plan": {
      "get": {
        "operationId": "libraryPythonDomainMigrationPlan",
        "responses": {
          "200": {
            "description": "Python domain migration sequence"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "signedService": {
        "type": "apiKey",
        "in": "header",
        "name": "X-SC-Signature",
        "description": "Signed service request; Authorization and X-SC-Timestamp are also required."
      },
      "librarySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sc_library_session",
        "description": "Opaque revocable Library session cookie; token is never stored in plaintext server-side."
      }
    }
  }
}
